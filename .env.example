# Database (local: Docker Postgres on host port 5433)
DB_URL=jdbc:postgresql://localhost:5433/spark_db
DB_USERNAME=postgres
DB_PASSWORD=Admin12345

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Server
SERVER_PORT=8081

# JWT (must be long enough for HS256 — at least 256 bits)
JWT_SECRET=dev-only-secret-key-change-me-this-must-be-at-least-256-bits-long
JWT_EXPIRATION_MS=3600000

# OTP
OTP_TTL_MINUTES=10
OTP_LENGTH=6

# Mail — real inbox delivery via Mailtrap Live Sending (SMTP)
MAIL_ENABLED=true
MAILTRAP_SMTP_HOST=live.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USERNAME=api
# Mailtrap → Settings → API Tokens (Admin access). Used as the SMTP password.
MAILTRAP_TOKEN=
# demomailtrap.co (the pre-verified demo domain) can only email the Mailtrap ACCOUNT OWNER.
# To email any registered user: Mailtrap → Sending Domains → add & verify your own domain,
# then change MAIL_FROM to an address on that domain.
MAIL_FROM=hello@demomailtrap.co
MAIL_FROM_NAME=Spark
